# PumpTires Monitor - Environment Configuration
# This file contains secrets and deployment-specific settings.
# Non-secret configuration (trading parameters, gas settings, performance tuning, etc.)
# lives in config.yaml for easier management and version control.

# ==============================================================================
# PulseChain Connection Settings
# ==============================================================================
# WebSocket URL for PulseChain RPC connection (for subscriptions)
PULSECHAIN_WSS_URL=wss://YOUR_PULSECHAIN_WSS_URL_HERE

# HTTP URL for PulseChain RPC connection (for transaction fetching)
PULSECHAIN_HTTP_URL=https://YOUR_PULSECHAIN_HTTP_URL_HERE

# Multi-RPC URLs for transaction broadcasting (comma-separated, no spaces)
# First URL should be primary authenticated endpoint, followed by fallback endpoints
PULSECHAIN_HTTP_URL2=https://YOUR_PULSECHAIN_HTTP_URL2_HERE

EXPECTED_CHAIN_ID=369

# ==============================================================================
# Contract Settings
# ==============================================================================
# Function selector for createToken(string,string)
# This is the first 4 bytes of keccak256("createToken(string,string)")
CREATE_TOKEN_SELECTOR=0x2f2f2d56
FACTORY_ADDRESS=0x6538A83a81d855B965983161AF6a83e616D16fD5

# ==============================================================================
# Trading Settings
# ==============================================================================
# ⚠️ SECURITY WARNING: Never commit real private keys to source control.
TRADING_PRIVATE_KEY="YOUR_PRIVATE_KEY_HERE"

